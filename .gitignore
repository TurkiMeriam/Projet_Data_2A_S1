```gitignore
# ==========================================
# PYTHON
# ==========================================

# Fichiers compilés
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging et distribution
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environnements virtuels
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Variables et configurations locales
.env
.env.*
!.env.example
.envrc

# Tests et couverture
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.cache/

# Analyse statique
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ==========================================
# JUPYTER / NOTEBOOKS
# ==========================================

.ipynb_checkpoints/
profile_default/
ipython_config.py

# ==========================================
# IDE / ÉDITEURS
# ==========================================

.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
tempCodeRunnerFile.py

# ==========================================
# PYTHON TOOLS
# ==========================================

.pdm-python
.pdm-build/
.pixi/*
!.pixi/config.toml
__pypackages__/

# ==========================================
# FRAMEWORKS ET OUTILS
# ==========================================

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx
docs/_build/

# PyBuilder
.pybuilder/
target/

# PyInstaller
*.manifest
*.spec

# Streamlit
.streamlit/secrets.toml

# Abstra
.abstra/

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# ==========================================
# AUTRES OUTILS
# ==========================================

# Cython
cython_debug/

# SageMath
*.sage.py

# Redis
*.rdb
*.aof
*.pid

# RabbitMQ
mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# ==========================================
# FORMATS DE FICHIERS EXCLUS
# ==========================================

*.zip
*.gpkg
*.shp

# ==========================================
# OUTPUTS DU PROJET
# ==========================================

# Ignorer les outputs par défaut
outputs/*

# Conserver les dossiers des figures et tableaux
!outputs/figures/
!outputs/Tables/

# Ignorer leur contenu par défaut
outputs/figures/*
outputs/Tables/*

# Conserver les tableaux CSV
!outputs/Tables/*.csv

# Conserver les fichiers de structure
!outputs/figures/.gitkeep
!outputs/Tables/.gitkeep

# ==========================================
# FICHIERS SYSTÈME
# ==========================================

.DS_Store
Thumbs.db
```